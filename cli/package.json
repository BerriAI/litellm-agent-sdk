{
  "name": "@litellm/agent-cli",
  "version": "0.1.0",
  "description": "CLI for LiteLLM Agent Platform — spawn and chat with agents from your terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lap": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node --import tsx/esm src/index.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "@litellm/agent-sdk": "file:.."
  },
  "peerDependencies": {
    "@litellm/agent-sdk": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@litellm/agent-sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "litellm",
    "agent",
    "cli",
    "lap",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  }
}
